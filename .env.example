# Chave compartilhada para liberar o acesso à conversa.
CHAT_ACCESS_KEY=troque-por-uma-chave-forte

# Opcional: se omitida, a chave de acesso também assina as sessões.
CHAT_SESSION_SECRET=troque-por-um-segredo-diferente

# Opcional: por padrão, o banco é criado em ./data/chat.db.
CHAT_DB_PATH=./data/chat.db

# Opcional: por padrão, as imagens são salvas em ./data/uploads.
CHAT_UPLOADS_PATH=./data/uploads

# Chave exclusiva para a cron interna que limpa mensagens e imagens.
CHAT_CLEANUP_KEY=troque-por-uma-chave-longa-e-diferente

# Opcional: endereço interno usado pela cron. A porta padrão do projeto é 25000.
CHAT_INTERNAL_URL=http://127.0.0.1:25000
